# Blue Bell Resort - Environment Variables Configuration

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Hotel Branding Defaults
NEXT_PUBLIC_HOTEL_NAME="Blue Bell Resort"
NEXT_PUBLIC_TAGLINE="Where comfort meets calm"
NEXT_PUBLIC_DEFAULT_CURRENCY="BDT"

# Supabase Configuration (Optional - The app features automatic offline & state persistence fallback)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Google Maps API Key (Optional - Fallback keyless embed is active automatically)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
